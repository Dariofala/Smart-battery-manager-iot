                      "group": "influxdb",
                      "version": "v0",
                      "datasource": {
                        "name": "efro5ijwdg2yoa"
                      },
                      "spec": {
                        "query": "from(bucket: \"sensors\")\r\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\r\n  |> filter(fn: (r) => r._measurement == \"iot_sensors\")\r\n  |> filter(fn: (r) => r.device == \"metrics\")\r\n  |> filter(fn: (r) => r.measurement_type == \"pdr\")\r\n  |> filter(fn: (r) => r._field == \"value\")\r\n  |> aggregateWindow(every: v.windowPeriod, fn: last, createEmpty: false)"
